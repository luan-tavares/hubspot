<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Request Suit">
            <directory>./tests/Request</directory>
        </testsuite>
        <testsuite name="Schema Suit">
            <directory>./tests/Schema</directory>
        </testsuite>
        <testsuite name="Resource Suit">
            <directory>./tests/Resource</directory>
        </testsuite>
        <testsuite name="Response Suit">
            <directory>./tests/Response</directory>
        </testsuite>
        <testsuite name="Builder Suit">
            <directory>./tests/Builder</directory>
        </testsuite>
        <testsuite name="Others Suit">
            <directory>./tests/Others</directory>
        </testsuite>
        <testsuite name="Handlers Suit">
            <directory>./tests/Handlers</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>src/Resources</directory>
            <directory>src/stubs</directory>
        </exclude>
    </source>
</phpunit>
